<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DroneLiDAR</AssemblyName>
    <RootNamespace>LidarRunner</RootNamespace>
    <Product>DroneLiDAR</Product>
    <Description>Экспресс-аудит земляных масс по данным БПЛА-LiDAR</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);.verify\**</DefaultItemExcludes>
  </PropertyGroup>
 <ItemGroup>
  <None Update="viewer.html">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="web\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="THIRD-PARTY-NOTICES.txt">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  
</ItemGroup>
 <ItemGroup>
   <PackageReference Include="Altemiq.IO.Las.Compression" Version="1.5.0" />
   <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
 </ItemGroup>

<!-- Автоматическая сборка релиза и архивация средствами MSBuild -->
  <Target Name="PublishAndZip" AfterTargets="Publish">
    <PropertyGroup>
      <PublishDir>$(PublishDir)</PublishDir>
      <ZipFileName>$(ProjectDir)bin\Release\$(TargetFramework)\win-x64\DroneLiDAR_Release.zip</ZipFileName>
    </PropertyGroup>

    <!-- Копируем viewer.html в папку публикации, чтобы он попал в архив -->
    <Copy SourceFiles="$(ProjectDir)viewer.html" DestinationFolder="$(PublishDir)" Condition="Exists('$(ProjectDir)viewer.html')" />
    <Copy SourceFiles="$(ProjectDir)THIRD-PARTY-NOTICES.txt" DestinationFolder="$(PublishDir)" Condition="Exists('$(ProjectDir)THIRD-PARTY-NOTICES.txt')" />
    <ItemGroup>
      <ViewerAssets Include="$(ProjectDir)web\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ViewerAssets)" DestinationFiles="@(ViewerAssets->'$(PublishDir)web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- Удаляем старый архив, если он уже существовал -->
    <Delete Files="$(ZipFileName)" Condition="Exists('$(ZipFileName)')" />

    <!-- Запаковываем всю папку publish в один .zip архив -->
    <Message Text="Упаковка релизной папки в архив: $(ZipFileName)" Importance="high" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ZipFileName)" Overwrite="true" />
  </Target>
</Project>
